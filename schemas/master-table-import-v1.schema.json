{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Hub Master Table — Reviewed JSON Import 1.0",
  "description": "Review metadata import for working Master Table only. Per-document review_status may be Approved, Draft or Obsolete; approval of the complete table is a separate administrator action. Source identity and hashes are never taken from imports.",
  "oneOf": [
    {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    {
      "type": "object",
      "required": [
        "records"
      ],
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/record"
          }
        }
      }
    }
  ],
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 1150
        },
        "title": {
          "type": "string",
          "maxLength": 220
        },
        "summary": {
          "type": "string",
          "maxLength": 2400
        },
        "key_terms": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "uniqueItems": true
        },
        "themes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "uniqueItems": true
        },
        "document_type": {
          "type": "string",
          "maxLength": 100
        },
        "important_sections": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "uniqueItems": true
        },
        "related_documents": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "uniqueItems": true
        },
        "review_notes": {
          "type": "string",
          "maxLength": 6000
        },
        "review_version": {
          "type": "string",
          "maxLength": 50
        },
        "last_reviewed": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "text_extraction": {
          "type": "string",
          "enum": [
            "NOT_ASSESSED",
            "COMPLETE",
            "PARTIAL",
            "FAILED"
          ]
        },
        "visual_inspection": {
          "type": "string",
          "enum": [
            "NOT_ASSESSED",
            "COMPLETE",
            "PARTIAL"
          ]
        },
        "related_source_ids": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 1150
          },
          "description": "Optional source identifiers. Server verifies source existence, access and current metadata signature before binding."
        },
        "review_status": {
          "type": "string",
          "enum": [
            "Approved",
            "Draft",
            "Obsolete"
          ],
          "description": "Optional explicit lifecycle status; absent values retain existing status, defaulting to Draft."
        }
      }
    }
  }
}
