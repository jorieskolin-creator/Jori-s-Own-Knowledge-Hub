{
  "version": 2,
  "functions": {
    "api/golden-standards.js": {"maxDuration": 120}
  },
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth?route=resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp-private",
      "destination": "/api/oauth?route=resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp-governed-private",
      "destination": "/api/oauth?route=resource-governed"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp-governed-unified",
      "destination": "/api/oauth?route=resource-unified"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth?route=metadata"
    },
    {
      "source": "/oauth/authorize",
      "destination": "/api/oauth?route=authorize"
    },
    {
      "source": "/oauth/register",
      "destination": "/api/oauth?route=register"
    },
    {
      "source": "/oauth/token",
      "destination": "/api/oauth?route=token"
    }
  ]
}
